y blur. 16:9, photorealistic cinematic style, heavy atmospheric perspective with desaturated, high-contrast color grading."],"color":"#232","bgcolor":"#353"}],"links":[[44,28,0,40,0,"INT"],[45,28,1,40,1,"INT"],[86,58,0,34,4,"INT"],[170,29,0,97,0,"IMAGE"],[171,28,0,97,2,"INT"],[172,28,1,97,3,"INT"],[173,97,0,91,0,"IMAGE"],[174,97,0,93,0,"IMAGE"],[182,96,0,99,0,"*"],[183,40,0,99,1,"LATENT"],[184,99,0,34,3,"LATENT"],[188,81,0,100,1,"STRING"],[199,102,0,104,0,"*"],[200,103,0,104,1,"FLOAT"],[201,104,0,34,9,"FLOAT"],[202,32,0,34,0,"MODEL"],[206,108,1,100,0,"CLIP"],[239,26,0,108,1,"CLIP"],[287,34,0,124,0,"LATENT"],[289,124,0,64,0,"IMAGE"],[290,124,0,68,0,"IMAGE"],[291,124,0,69,0,"IMAGE"],[293,125,0,126,1,"MODEL_PATCH"],[297,108,0,126,0,"MODEL"],[298,126,0,32,0,"MODEL"],[299,100,0,34,1,"CONDITIONING"],[301,127,0,34,2,"CONDITIONING"],[303,100,0,127,0,"CONDITIONING"],[305,24,0,108,0,"MODEL"],[311,135,0,137,0,"IMAGE"],[312,136,0,137,2,"FLOAT"],[322,124,0,135,1,"IMAGE"],[323,65,0,135,0,"UPSCALE_MODEL"],[324,35,0,136,0,"FLOAT"],[338,91,0,142,0,"IMAGE"],[339,93,0,142,1,"IMAGE"],[340,142,0,126,3,"IMAGE"],[341,142,0,95,0,"IMAGE"],[342,142,0,96,0,"IMAGE"],[352,32,0,152,1,"MODEL"],[353,100,0,152,2,"CONDITIONING"],[354,127,0,152,3,"CONDITIONING"],[356,137,0,152,0,"IMAGE"],[357,152,0,140,0,"IMAGE"],[358,152,0,70,0,"IMAGE"],[359,152,0,69,1,"IMAGE"],[361,58,0,153,0,"INT"],[364,154,0,140,1,"STRING"],[365,154,0,64,1,"STRING"],[367,89,0,154,0,"STRING"],[368,153,0,154,1,"STRING"],[369,155,0,126,2,"VAE"],[370,155,0,152,4,"VAE"],[371,155,0,124,1,"VAE"],[372,155,0,96,1,"VAE"]],"groups":[{"id":6,"title":"Base Setup","bounding":[-260,760,1040,560],"color":"#88A","font_size":24,"flags":{}},{"id":7,"title":"Reference Image","bounding":[800,760,460,560],"color":"#8AA","font_size":24,"flags":{}},{"id":8,"title":"Prompt","bounding":[-260,1340,480,460],"color":"#b58b2a","font_size":24,"flags":{}},{"id":9,"title":"Sampler","bounding":[240,1340,880,800],"color":"#3f789e","font_size":24,"flags":{}},{"id":